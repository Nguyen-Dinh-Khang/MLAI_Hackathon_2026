# =====================================================================
# CẤU HÌNH KẾT NỐI MONGODB - MLAI DECISION INTELLIGENCE PLATFORM
# FILE MẪU: Hãy sao chép file này thành .env và điền thông tin thực tế
# =====================================================================

# 1. MongoDB Atlas URI (Thay <username> và <password> bằng tài khoản của bạn)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# 2. Hoặc nếu bạn chạy MongoDB Local:
# MONGO_URI=mongodb://localhost:27017

# Tên Cơ sở dữ liệu trong MongoDB
DB_NAME=MLAI_Hackathon_2026

# Cổng máy chủ web mini
PORT=8000
